# Rust build output
/target
# discovery spikes are standalone cargo projects, so their build output is not
# covered by the root-anchored rule above
spike/*/target/
# web build output + deps
/dist
/node_modules
# cargo-mutants run output (a periodic audit, not a build artifact — the
# findings belong in the plan's Review Log, not in the tree)
/mutants.out
/mutants.out.old
# Playwright artifacts
/test-results
/playwright-report
/.last-run.json
# per-machine
.DS_Store
reference/

# WebLLM model cache (ai:trial) — never commit the multi-GB weights
.webllm-cache/

# assets/new/ is a DROP-OFF for raw masters, not a deliverable. The repo carries
# only the derived web-sized copies that tools/intake.mjs produces from them.
/assets/new/*
!/assets/new/README.md
