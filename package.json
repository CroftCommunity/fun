{
  "name": "fun-croft-ing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "fun.croft.ing — the Croft games pond. A determinism-first, local-first game shelf (Rust cores compiled to wasm, vanilla TS slide-out drawer UI).",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:wasm": "bash tools/build-wasm.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preunit": "npm run build:wasm",
    "unit": "vitest run",
    "e2e": "playwright test",
    "guide:shots": "node tools/guide-shots.mjs",
    "ai:trial": "node build.mjs && node tools/ai-trial.mjs",
    "harness:trial": "node build.mjs && node tools/harness-trial.mjs",
    "baselines": "npm run build:wasm && HARNESS_BASELINES=1 vitest run tests/baselines.test.ts",
    "serve": "node build.mjs && node tools/serve.mjs",
    "test:rust": "bash tools/rust-gate.sh",
    "test": "npm run test:rust && npm run typecheck && npm run lint && npm run unit && npm run build",
    "gate": "npm run test && npm run e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84"
  },
  "overrides": {
    "playwright-core": "1.61.1"
  }
}
